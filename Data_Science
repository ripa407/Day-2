        "\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "print('Dataset Shape for Clustering:', df.shape)\n",
        "\n",
        "df['Codepoint_Val'] = (\n",
        "    df['Codepoint']\n",
        "    .str.replace('U+', '', regex=False)\n",
        "    .str.replace(' ', '', regex=False)\n",
        "    .apply(lambda x: int(x, 16))\n",
        ")\n",
        "\n",
        "df['Name_Length'] = df['Name'].str.len()\n",
        "df['Word_Count'] = df['Name'].str.split().str.len()\n",
        "\n",
        "features = ['Codepoint_Val', 'Name_Length', 'Word_Count']\n",
        "X = df[features]\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "inertias = []\n",
        "K_range = range(1, 10)\n",
        "for k in K_range:\n",
        "  kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "  kmeans.fit(X_scaled)\n",
        "  inertias.append(kmeans.inertia_)\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.plot(K_range, inertias, marker='o', linestyle='-', color='b')\n",
        "plt.title('Elbow Method for Optimal K (Cluster Selection)')\n",
        "plt.xlabel('Number of Clusters (K)')\n",
        "plt.ylabel('Inertia (Within-cluster sum of squares)')\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "optimal_k = 4\n",
        "kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
        "df['Cluster'] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "print('\\n (Mean Values Analysis) ---')\n",
        "print(df.groupby('Cluster')[features].mean())\n",
        "\n",
        "print('\\n (Cluster Sizes) ---')\n",
        "print(df['Cluster'].value_counts())\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(\n",
        "    data=df,\n",
        "    x='Codepoint_Val',\n",
        "    y='Name_Length',\n",
        "    hue='Cluster',\n",
        "    palette='Set1',\n",
        "    alpha=0.7,\n",
        ")\n",
        "plt.title('Unicode Character Clusters: Codepoint Value vs. Name Length')\n",
        "plt.xlabel('Codepoint Numerical Value')\n",
        "plt.ylabel('Name Length (Characters)')\n",
        "plt.legend(title='Cluster ID')\n",
        "plt.show()\n",
        "\n",
        "output_filename = 'unicode_character_clusters_output.csv'\n",
        "df.to_csv(output_filename, index=False, encoding='utf-8-sig')\n",
        "print(\n",
        "\n",
        "    f' {output_filename}'\n",
        ")\n",
        "\n",
        "from google.colab import files\n",
        "\n",
        "files.download(output_filename)"
