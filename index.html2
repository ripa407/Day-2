```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nazmunnahar Ripa - Personal Profile</title>
    <link rel="stylesheet" href="style.css">

    <style>
        body {
            background-color: lightgray;
            font-family: Arial;
            margin: 20px;
        }

        header {
            background-color: white;
            text-align: center;
            padding: 20px;
        }

        h1 {
            color: darkblue;
        }

        h2 {
            color: darkblue;
        }

        section {
            background-color: white;
            padding: 20px;
            margin: 15px 0;
        }

        img {
            width: 200px;
            border-radius: 10px;
        }

        ul {
            line-height: 1.8;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            background-color: lightblue;
        }

        th, td {
            padding: 10px;
        }

        input, textarea {
            padding: 8px;
            margin-top: 5px;
        }

        button {
            background-color: darkblue;
            color: white;
            padding: 10px 20px;
            border: none;
        }

        a {
            color: blue;
        }

        footer {
            background-color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Nazmunnahar Ripa</h1>
        <p>CSE Student &amp; Aspiring UI/UX Designer</p>
    </header>

    <hr>

    <main>

        <section>
            <h2>About Me</h2>

            <img
                src="images/photo.jpg"
                alt="Professional portrait of a young woman"
                width="200"
            >

            <p>
                Hello! I am Nazmunnahar Ripa, a Computer Science and Engineering
                student who is interested in technology, web design, and creative
                digital experiences.
            </p>

            <p>
                I enjoy learning new technologies and improving my design skills.
                My goal is to build useful, simple, and user-friendly digital
                products while continuously developing my technical knowledge.
            </p>
        </section>

        <section>
            <h2>My Skills</h2>
            <ul>
                <li>HTML</li>
                <li>UI/UX Design</li>
                <li>Figma</li>
                <li>Basic Programming</li>
                <li>Communication</li>
            </ul>
        </section>

        <section>
            <h2>Education</h2>

            <table border="1" cellpadding="8">
                <thead>
                    <tr>
                        <th>Level</th>
                        <th>Institution</th>
                        <th>Result / Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>SSC</td>
                        <td>Rajapur High SCHOOL</td>
                        <td>GPA 4.50</td>
                    </tr>
                    <tr>
                        <td>HSC</td>
                        <td>Perojpur Govt COLLEGE</td>
                        <td>GPA 4.75</td>
                    </tr>
                    <tr>
                        <td>BSc in CSE</td>
                        <td>Northern University of Business and Technology Khulna</td>
                        <td>Final Semester</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section>
            <h2>Contact Me</h2>

            <form>
                <p>
                    <label for="name">Name:</label><br>
                    <input type="text" id="name" name="name" required>
                </p>

                <p>
                    <label for="email">Email:</label><br>
                    <input type="email" id="email" name="email" required>
                </p>

                <p>
                    <label for="message">Message:</label><br>
                    <textarea id="message" name="message" rows="6" cols="40" required></textarea>
                </p>

                <p>
                    <button type="submit">Send Message</button>
                </p>
            </form>
        </section>

    </main>

    <hr>

    <footer>
        <p>
            &copy; 2026 Nazmunnahar Ripa |
            <a href="https://www.linkedin.com/" target="_blank" rel="noopener">
                Visit LinkedIn
            </a>
        </p>
    </footer>

</body>
</html>
